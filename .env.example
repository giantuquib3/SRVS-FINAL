# Supabase PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=2"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Secret for Session Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Application Metadata & Base URL (used for password reset links)
NEXT_PUBLIC_APP_NAME="SRVS — Syllabus Repository, Revision and Versioning System"
APP_URL="http://localhost:3000"

# Gmail SMTP Configuration (use a 16-character Google App Password)
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="SRVS — USJ-R <your-gmail@gmail.com>"
