generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Real PostgreSQL foreign keys are enforced by the database (no relationMode = "prisma").
}

// Database-level rules NOT expressed in this file (see prisma/sql/db-integrity.sql,
// applied with `node scripts/migrate-db-integrity.js`; `prisma db push` leaves them in place):
//   - CHECK constraints on users.role / accountStatus, syllabi.status / semester,
//     syllabus_versions.approvalStatus / statusAtSave, subjects.semester (allowed values: src/lib/status.ts)
//   - Trigger student_subjects_enforce_rules (prisma/sql/student-subjects.sql): only users with
//     role 'Student' can be associated with subjects.
//   - CHECK constraints on student_subjects.status / semester / academicYear
//     (prisma/sql/student-subjects-columns.sql).
//   - Row level security enabled on student_subjects (blocks the public Supabase REST API).

// 1. Academic Departments (Institutional Engineering Departments)
model Department {
  id          String   @id // String ID: CPE, EE, CE, ECE, IE, ME
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users   User[]
  subjects Subject[]
  syllabi Syllabus[]

  @@map("departments")
}

// 2. Master User Directory (Admins, Department Heads, Educators, and Students)
model User {
  id            Int         @id // University ID: 0 (Admin), 5 digits (Faculty/DeptHead), 10 digits / numeric (Student)
  email         String      @unique
  passwordHash  String
  fullName      String
  role          String      @default("Student") // Admin, DepartmentHead, Educator, Student
  departmentId  String?     // CPE, EE, CE, ECE, IE, ME (References Department.id)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicRank  String?     // Department Chairperson, Assistant Professor, Instructor, etc.
  yearLevel     String?     // 1st Year, 2nd Year, 3rd Year, 4th Year
  accountStatus      String      @default("Active") // Active, PendingApproval, Rejected, Deactivated
  mustChangePassword Boolean?    @default(false)
  rejectionReason    String?
  program            String?     // Degree program e.g. BS Computer Engineering
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  // Relational Connections
  syllabiAuthored     Syllabus[]        @relation("InstructorSyllabi")
  syllabiReviewed     Syllabus[]        @relation("DeptHeadReviewedSyllabi")
  studentSubjects     StudentSubject[]  @relation("StudentSubjects")
  enrollmentsCreated  StudentSubject[]  @relation("StudentSubjectsEnrolledBy")

  // Revisions & Audits
  editedVersions    SyllabusVersion[] @relation("EditorVersions")
  submittedVersions SyllabusVersion[] @relation("SubmittedVersions")
  reviewedVersions  SyllabusVersion[] @relation("ReviewedVersions")
  auditLogs         AuditLog[]

  @@index([role])
  @@index([departmentId])
  @@index([accountStatus])
  @@map("users")
}

// 3. Subjects (Academic Curriculum Catalog — what a subject IS, independent of any term)
model Subject {
  id            Int         @id @default(autoincrement()) // INTEGER primary key
  code          String      @unique // e.g. "CPE101"
  title         String
  description   String?
  units         Int         @default(3)
  lecHours      Int         @default(3)
  labHours      Int         @default(0)
  prerequisite  String?     @default("None")
  yearLevel     String?     @default("1st Year")     // Recommended curriculum year level
  semester      String?     @default("1st Semester") // Recommended curriculum semester
  departmentId  String      // References Department.id (CPE, EE, CE, ECE, IE, ME)
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  professorName String?     // Instructor / subject coordinator shown with the subject (display label)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  syllabi         Syllabus[]
  studentSubjects StudentSubject[]

  @@index([departmentId])
  @@map("subjects")
}

// 4. Student <-> Subject associations (junction table: many Students <-> many Subjects)
//    Names / titles are NOT stored here; read them from users.fullName and subjects.title.
model StudentSubject {
  id        Int      @id @default(autoincrement())
  studentId Int      // References users.id (role = Student, enforced by trigger)
  student   User     @relation("StudentSubjects", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_subjects_student")
  subjectId Int      // References subjects.id
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_subjects_subject")
  createdAt DateTime @default(now()) @db.Timestamp(6)

  // Describe this student's enrollment in this subject
  status       String  @default("ENROLLED")     // ENROLLED, COMPLETED, DROPPED (CHECK constraint)
  academicYear String  @default("2026-2027")    // e.g. "2026-2027" (CHECK constraint: YYYY-YYYY)
  semester     String  @default("1st Semester") // 1st Semester, 2nd Semester, Summer (CHECK constraint)
  enrolledById Int?                             // References users.id: who created the enrollment
  enrolledBy   User?   @relation("StudentSubjectsEnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_student_subjects_enrolled_by")

  @@unique([studentId, subjectId], map: "uq_student_subjects")
  @@index([subjectId])
  @@index([enrolledById])
  @@index([status])
  @@map("student_subjects")
}

// 5. Master Syllabi Approvals
model Syllabus {
  id                   Int             @id @default(autoincrement()) // INTEGER primary key
  subjectId            Int             // INTEGER references subjects.id
  subject              Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  instructorId         Int             // INTEGER references users.id
  instructor           User            @relation("InstructorSyllabi", fields: [instructorId], references: [id], onDelete: Cascade)
  departmentId         String          // References Department.id
  department           Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academicYear         String
  semester             String
  section              String          @default("A")
  status               String          @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  currentVersionNumber Int             @default(1)
  reviewerRemarks      String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedByUserId     Int?            // INTEGER references users.id
  reviewedBy           User?           @relation("DeptHeadReviewedSyllabi", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  versions SyllabusVersion[]

  @@index([subjectId])
  @@index([departmentId])
  @@index([instructorId])
  @@index([status])
  @@map("syllabi")
}

// 6. Syllabus Versions & Revision Tracking
model SyllabusVersion {
  id              Int      @id @default(autoincrement()) // INTEGER primary key
  syllabusId      Int      // INTEGER references syllabi.id
  syllabus        Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  versionNumber   Int
  editorId        Int      // INTEGER references users.id
  editor          User     @relation("EditorVersions", fields: [editorId], references: [id], onDelete: Cascade)
  changeSummary   String
  changeType      String   @default("Create") // Create, Edit, Submit, Approve, Reject, Restore
  statusAtSave    String   @default("DRAFT")
  approvalStatus  String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  content         Json

  // Document upload fields (PDF, DOC, DOCX)
  fileName String?
  fileUrl  String?
  fileType String?
  fileSize Int?

  // Submission & Review tracking
  submittedById   Int?      // INTEGER references users.id
  submittedBy     User?     @relation("SubmittedVersions", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  reviewedById    Int?      // INTEGER references users.id
  reviewedBy      User?     @relation("ReviewedVersions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([syllabusId, versionNumber], map: "syllabus_versions_unique_version")
  @@index([syllabusId])
  @@index([approvalStatus])
  @@map("syllabus_versions")
}

// 7. System Audit Trail
model AuditLog {
  id              Int      @id @default(autoincrement()) // INTEGER primary key
  userId          Int?     // INTEGER references users.id
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userDisplayName String?
  actionType      String   // Login, Register, ApproveUser, RejectUser, CreateCourse, EnrollStudent, SubmitSyllabus, etc.
  resultStatus    String   @default("Success") // Success, Failed, Warning
  description     String
  entityType      String?  // User, Course, Syllabus, Enrollment
  entityId        String?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([resultStatus])
  @@map("audit_logs")
}
