generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

// 1. Academic Departments (Institutional Engineering Departments)
model Department {
  id          String   @id // String ID: CPE, EE, CE, ECE, IE, ME
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users   User[]
  courses Course[]
  syllabi Syllabus[]

  @@map("departments")
}

// 2. Master User Directory (Admins, Department Heads, Educators, and Students)
model User {
  id            Int         @id // University ID: 0 (Admin), 5 digits (Faculty/DeptHead), 10 digits / numeric (Student)
  email         String      @unique
  passwordHash  String
  fullName      String
  role          String      @default("Student") // Admin, DepartmentHead, Educator, Student
  departmentId  String?     // CPE, EE, CE, ECE, IE, ME (References Department.id)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicRank  String?     // Department Chairperson, Assistant Professor, Instructor, etc.
  yearLevel     String?     // 1st Year, 2nd Year, 3rd Year, 4th Year
  accountStatus String      @default("Active") // Active, PendingApproval, Rejected, Deactivated
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relational Connections
  coursesAssigned   Course[]          @relation("FacultyCourses")
  syllabiAuthored   Syllabus[]        @relation("InstructorSyllabi")
  syllabiReviewed   Syllabus[]        @relation("DeptHeadReviewedSyllabi")
  enrollments       Enrollment[]      @relation("StudentEnrollments")

  // Revisions & Audits
  editedVersions    SyllabusVersion[] @relation("EditorVersions")
  submittedVersions SyllabusVersion[] @relation("SubmittedVersions")
  reviewedVersions  SyllabusVersion[] @relation("ReviewedVersions")
  auditLogs         AuditLog[]

  @@index([role])
  @@index([departmentId])
  @@index([accountStatus])
  @@map("admin")
}

// 3. Courses (Academic Curriculum Catalog)
model Course {
  id           Int         @id @default(autoincrement()) // INTEGER primary key
  code         String      @unique // e.g. "CPE101"
  title        String
  description  String?
  units        Int         @default(3)
  lecHours     Int         @default(3)
  labHours     Int         @default(0)
  prerequisite String?     @default("None")
  yearLevel    String?     @default("1st Year")
  semester     String?     @default("1st Semester")
  departmentId String      // References Department.id
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facultyName  String?     // Name of professor who uploaded syllabus
  facultyId    Int?        // Connected to User.id (users)
  faculty      User?       @relation("FacultyCourses", fields: [facultyId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  syllabi     Syllabus[]
  enrollments Enrollment[]

  @@index([departmentId])
  @@index([facultyId])
  @@map("courses")
}

// 4. Student Course Enrollments
model Enrollment {
  studentId    Int      // Numeric Student ID (references users.id)
  studentName  String   // Full Name of the enrolled student
  courseId     Int      // INTEGER Course ID (references courses.id)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  semester     String   @default("1st Semester")
  academicYear String   @default("2026-2027")
  section      String   @default("A")
  status       String   @default("ENROLLED") // ENROLLED, COMPLETED, DROPPED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

// 5. Master Syllabi Approvals
model Syllabus {
  id                   Int             @id @default(autoincrement()) // INTEGER primary key
  courseId             Int             // INTEGER references courses.id
  course               Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId         Int             // INTEGER references users.id
  instructor           User            @relation("InstructorSyllabi", fields: [instructorId], references: [id], onDelete: Cascade)
  departmentId         String          // References Department.id
  department           Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academicYear         String
  semester             String
  section              String          @default("A")
  status               String          @default("Draft") // Draft, Submitted, Approved, Rejected
  currentVersionNumber Int             @default(1)
  reviewerRemarks      String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedByUserId     Int?            // INTEGER references users.id
  reviewedBy           User?           @relation("DeptHeadReviewedSyllabi", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  versions SyllabusVersion[]

  @@index([courseId])
  @@index([departmentId])
  @@index([instructorId])
  @@index([status])
  @@map("syllabi")
}

// 6. Syllabus Versions & Revision Tracking
model SyllabusVersion {
  id              Int      @id @default(autoincrement()) // INTEGER primary key
  syllabusId      Int      // INTEGER references syllabi.id
  syllabus        Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  versionNumber   Int
  editorId        Int      // INTEGER references users.id
  editor          User     @relation("EditorVersions", fields: [editorId], references: [id])
  changeSummary   String
  changeType      String   @default("Create") // Create, Edit, Submit, Approve, Reject, Restore
  statusAtSave    String   @default("Draft")
  approvalStatus  String   @default("Draft") // Draft, Submitted, Approved, Rejected
  content         Json

  // Document upload fields (PDF, DOC, DOCX)
  fileName String?
  fileUrl  String?
  fileType String?
  fileSize Int?

  // Submission & Review tracking
  submittedById   Int?      // INTEGER references users.id
  submittedBy     User?     @relation("SubmittedVersions", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  reviewedById    Int?      // INTEGER references users.id
  reviewedBy      User?     @relation("ReviewedVersions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([syllabusId, versionNumber])
  @@index([syllabusId])
  @@index([approvalStatus])
  @@map("syllabus_versions")
}

// 7. System Audit Trail
model AuditLog {
  id              Int      @id @default(autoincrement()) // INTEGER primary key
  userId          Int?     // INTEGER references users.id
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userDisplayName String?
  actionType      String   // Login, Register, ApproveUser, RejectUser, CreateCourse, EnrollStudent, SubmitSyllabus, etc.
  resultStatus    String   @default("Success") // Success, Failed, Warning
  description     String
  entityType      String?  // User, Course, Syllabus, Enrollment
  entityId        String?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([resultStatus])
  @@map("audit_logs")
}
