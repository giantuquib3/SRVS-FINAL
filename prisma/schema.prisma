generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id              Int              @id @default(autoincrement())
  code            String           @unique // CE, CPE, ECE, IE, ME, EE
  name            String           @unique // Civil Engineering, Computer Engineering, etc.
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  subjects        Subject[]
  users           User[]
  departmentHeads DepartmentHead[]
  faculties       Faculty[]
  students        Student[]
  syllabi         Syllabus[]

  @@map("srvs_departments")
}

model Subject {
  id           Int          @id @default(autoincrement())
  code         String       @unique // e.g. CPE101
  title        String       // Descriptive Title
  description  String?
  units        Int          @default(3) // Academic Credit Units
  lecHours     Int          @default(3) // Lecture Hours per week
  labHours     Int          @default(0) // Laboratory Hours per week
  prerequisite String?      @default("None") // Prerequisite subject(s)
  yearLevel    String?      @default("1st Year") // 1st Year, 2nd Year, 3rd Year, 4th Year
  semester     String?      @default("1st Semester") // 1st Semester, 2nd Semester, Summer
  departmentId Int
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  syllabi      Syllabus[]
  enrollments  Enrollment[]

  @@index([departmentId])
  @@map("srvs_subjects")
}

model User {
  id                Int                   @id @default(autoincrement())
  idNumber          String                @unique // University ID Number: 00000 (Admin), 5 digits (Faculty/DeptHead), 10 digits (Student)
  email             String                @unique
  passwordHash      String
  firstName         String                @default("")
  lastName          String                @default("")
  fullName          String
  role              String                @default("Student") // Admin, DepartmentHead, Educator, Student
  departmentId      Int?
  department        Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  accountStatus     String                @default("Active") // Active, PendingApproval, Rejected, Deactivated
  createdAt         DateTime              @default(now())
  lastLoginAt       DateTime?

  // Segregated role profiles
  adminProfile      Admin?
  deptHeadProfile   DepartmentHead?
  facultyProfile    Faculty?
  studentProfile    Student?

  // Functional relations
  enrollments       Enrollment[]
  instructorSyllabi Syllabus[]            @relation("InstructorSyllabi")
  createdSyllabi    Syllabus[]            @relation("CreatedSyllabi")
  reviewedSyllabi   Syllabus[]            @relation("ReviewedSyllabi")
  editedVersions    SyllabusVersion[]     @relation("EditorVersions")
  submittedVersions SyllabusVersion[]     @relation("SubmittedVersions")
  reviewedVersions  SyllabusVersion[]     @relation("ReviewedVersions")

  @@index([departmentId])
  @@index([role])
  @@map("srvs_users")
}

model Admin {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminNumber String   @unique // e.g. 00000
  fullName    String
  email       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("srvs_admins")
}

model DepartmentHead {
  id             Int        @id @default(autoincrement())
  userId         Int        @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String     @unique // e.g. 10001
  fullName       String
  email          String
  department     String     @map("department") // e.g. CPE, CE, EE (department code, not numeric ID)
  departmentRel  Department @relation(fields: [department], references: [code], onDelete: Cascade)
  title          String?    @default("Department Chairperson")
  officeLocation String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([department])
  @@map("srvs_department_heads")
}

model Faculty {
  id            Int        @id @default(autoincrement())
  userId        Int        @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String     @unique // e.g. 10002
  fullName      String
  email         String
  department    String     @map("department") // e.g. CPE, CE, EE (department code, not numeric ID)
  departmentRel Department @relation(fields: [department], references: [code], onDelete: Cascade)
  academicRank  String?    @default("Faculty Member")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([department])
  @@map("srvs_faculties")
}

model Student {
  id               Int         @id @default(autoincrement())
  userId           Int         @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentIdNumber  String      @unique // e.g. 2022012708
  fullName         String
  email            String
  department       String?     @map("department") // e.g. CPE, CE, EE (department code, not numeric ID)
  departmentRel    Department? @relation(fields: [department], references: [code], onDelete: SetNull)
  enrolledSubjects String?     @default("") // Enrolled subject codes only (e.g. "CPE101, CPE201")
  yearLevel        String?     @default("1st Year")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([department])
  @@map("srvs_students")
}

model Syllabus {
  id                   Int               @id @default(autoincrement())
  subjectId            Int
  subject              Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  instructorId         Int
  instructor           User              @relation("InstructorSyllabi", fields: [instructorId], references: [id], onDelete: Cascade)
  createdById          Int?
  createdBy            User?             @relation("CreatedSyllabi", fields: [createdById], references: [id], onDelete: SetNull)
  uploadedByUserId     String?           // University ID Number (e.g. 10001)
  departmentId         Int
  department           Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  academicYear         String
  semester             String
  section              String            @default("A")
  status               String            @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, ACTIVE, ARCHIVED
  currentVersionNumber Int               @default(1) // Officially approved current version
  reviewerRemarks      String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedByUserId     Int?
  reviewedBy           User?             @relation("ReviewedSyllabi", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  versions             SyllabusVersion[]

  @@index([subjectId])
  @@index([departmentId])
  @@index([instructorId])
  @@index([uploadedByUserId])
  @@index([status])
  @@map("srvs_syllabi")
}

model SyllabusVersion {
  id               Int       @id @default(autoincrement())
  syllabusId       Int
  syllabus         Syllabus  @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  versionNumber    Int
  editorId         Int
  editor           User      @relation("EditorVersions", fields: [editorId], references: [id])
  uploadedByUserId String?   // University ID Number (e.g. 10001)
  changeSummary    String
  changeType       String    @default("Create") // Create, Edit, Submit, Approve, Reject, Restore
  statusAtSave     String    @default("DRAFT")
  approvalStatus   String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  content          Json      // Complete immutable content snapshot

  // Document upload fields (PDF, DOC, DOCX)
  fileName         String?
  fileUrl          String?
  fileType         String?
  fileSize         Int?

  // Submission & Review tracking
  submittedById    Int?
  submittedBy      User?     @relation("SubmittedVersions", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt      DateTime?
  reviewedById     Int?
  reviewedBy       User?     @relation("ReviewedVersions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  rejectionReason  String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([syllabusId, versionNumber])
  @@index([syllabusId])
  @@index([approvalStatus])
  @@index([uploadedByUserId])
  @@map("srvs_syllabus_versions")
}

model Enrollment {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    Int
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester     String   // 1st Semester, 2nd Semester, Summer Term
  academicYear String   // e.g. 2026-2027
  section      String   @default("A")
  status       String   @default("ENROLLED") // ENROLLED, COMPLETED, DROPPED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, subjectId, semester, academicYear])
  @@index([studentId])
  @@index([subjectId])
  @@map("srvs_enrollments")
}
